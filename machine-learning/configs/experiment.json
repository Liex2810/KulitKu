{
  "seed": 42,
  "classes": [
    "Eczema",
    "Herpes Zoster",
    "Normal",
    "Ringworm"
  ],
  "paths": {
    "dataset_root": "/content/drive/MyDrive/KulitKu/datasets/original",
    "output_root": "/content/drive/MyDrive/KulitKu/hasil"
  },
  "cleaning": {
    "max_pixels": 25000000,
    "min_side": 128,
    "exclude_below_minimum": false,
    "minimum_reason": "",
    "workers": 2,
    "manual_review_csv": ""
  },
  "eda": {
    "sample_per_class": 200,
    "gallery_per_class": 8
  },
  "split": {
    "mode": "exploratory_hash",
    "holdout_folds": 5,
    "folds": 5,
    "lineage_csv": ""
  },
  "extractors": {
    "mobilenetv4": {
      "id": "mobilenetv4_conv_small.e2400_r224_in1k",
      "pretrained": true
    },
    "resnet50": {
      "id": "resnet50.a1_in1k",
      "pretrained": true
    },
    "convnext_tiny": {
      "id": "convnext_tiny.fb_in1k",
      "pretrained": true
    }
  },
  "features": {
    "batch_size": 32
  },
  "classifiers": {
    "logistic_regression": {
      "model__C": [
        0.1,
        1,
        10
      ],
      "model__class_weight": [
        null,
        "balanced"
      ]
    },
    "svm": {
      "model__C": [
        0.1,
        1,
        10
      ],
      "model__kernel": [
        "linear",
        "rbf"
      ],
      "model__gamma": [
        "scale"
      ],
      "model__class_weight": [
        null,
        "balanced"
      ]
    },
    "random_forest": {
      "model__n_estimators": [
        200,
        400
      ],
      "model__max_depth": [
        null,
        20
      ],
      "model__class_weight": [
        null,
        "balanced"
      ]
    }
  },
  "training": {
    "jobs": 2
  },
  "selection": {
    "macro_f1_tolerance": 0.01
  },
  "benchmark": {
    "threads": 2,
    "samples_per_class": 25,
    "repeats": 3,
    "warmup": 10
  },
  "evaluation": {
    "bootstrap_repeats": 1000
  },
  "export": {
    "parity_per_class": 5
  }
}
